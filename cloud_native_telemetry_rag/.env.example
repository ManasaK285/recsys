APP_NAME=Cloud-Native Telemetry & RAG Observability Engine
HOST=0.0.0.0
PORT=8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCS_DIR=data/docs
EVAL_SET_PATH=data/eval_set.json
P95_LATENCY_THRESHOLD_MS=1000
ERROR_RATE_THRESHOLD=0.05
AVG_TOKEN_THRESHOLD=2500
MIN_RECALL_AT_K=0.60
RECALL_BASELINE=0.75
RECALL_DRIFT_TOLERANCE=0.15
USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
BIGQUERY_ENABLED=false
BIGQUERY_DATASET=rag_observability
BIGQUERY_TABLE=telemetry_events
